{
	"name": "viatrade-frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"prepare": "husky",
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"api:gen": "orval && node scripts/generate-orval-types-index.mjs",
		"types": "tsc -p tsconfig.app.json",
		"lint": "set TIMING=1 && eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier . -c -u --cache",
		"format:fix": "prettier . -w -u --cache",
		"check": " npm run lint && npm run types && npm run format",
		"check:fix": "npm run lint:fix && npm run types && npm run format:fix"
	},
	"lint-staged": {
		"*.{ts,tsx}": "bash -c 'tsc -p tsconfig.app.json'",
		"*.{js,jsx,ts,tsx}": "eslint",
		"*": "prettier -u --log-level error"
	},
	"dependencies": {
		"@mantine/core": "^9.1.1",
		"@mantine/dates": "^9.1.1",
		"@mantine/form": "^9.1.1",
		"@mantine/hooks": "^9.1.1",
		"@mantine/modals": "^9.1.1",
		"@mantine/nprogress": "^9.1.1",
		"@tabler/icons-react": "^3.41.1",
		"@tanstack/react-query": "^5.100.5",
		"@tanstack/react-query-devtools": "^5.100.5",
		"clsx": "^2.1.1",
		"dayjs": "^1.11.20",
		"postcss": "^8.5.12",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"react": "^19.2.5",
		"react-dom": "^19.2.5",
		"react-router": "^7.14.2",
		"valibot": "^1.3.1",
		"valibot-i18n-better-ru": "^1.0.4"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^7.7.3",
		"@eslint-react/eslint-plugin": "^2.13.0",
		"@faker-js/faker": "^10.4.0",
		"@svgr/plugin-jsx": "^8.1.0",
		"@svgr/plugin-svgo": "^8.1.0",
		"@types/node": "^25.6.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.2.0",
		"babel-plugin-react-compiler": "^1.0.0",
		"deepmerge-ts": "^7.1.5",
		"eslint": "^9.39.4",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"globals": "^17.4.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"msw": "^2.14.5",
		"orval": "^8.9.1",
		"prettier": "^3.8.1",
		"typescript": "~5.9.3",
		"vite": "^7.3.1",
		"vite-bundle-analyzer": "^1.3.7",
		"vite-plugin-pwa": "^1.2.0",
		"vite-plugin-svgr": "^5.2.0"
	}
}
