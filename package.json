{
	"name": "viatrade-frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"prepare": "husky",
		"dev": "vite --host 127.0.0.1",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"api:gen": "orval && node scripts/generate-orval-types-index.mjs",
		"types": "tsc -p tsconfig.app.json",
		"lint": "set TIMING=1 && eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier . -c -u --cache",
		"format:fix": "prettier . -w -u --cache",
		"check": " npm run lint && npm run types && npm run format",
		"check:fix": "npm run lint:fix && npm run types && npm run format:fix"
	},
	"lint-staged": {
		"*.{ts,tsx}": "bash -c 'tsc -p tsconfig.app.json'",
		"*.{js,jsx,ts,tsx}": "eslint",
		"*": "prettier -u --log-level error"
	},
	"dependencies": {
		"@fontsource-variable/roboto": "^5.2.10",
		"@fontsource/poppins": "^5.2.7",
		"@mantine/core": "^9.2.0",
		"@mantine/dates": "^9.2.0",
		"@mantine/form": "^9.2.0",
		"@mantine/hooks": "^9.2.0",
		"@mantine/modals": "^9.2.0",
		"@mantine/nprogress": "^9.2.0",
		"@tabler/icons-react": "^3.44.0",
		"@tanstack/react-query": "^5.100.10",
		"@tanstack/react-query-devtools": "^5.100.10",
		"clsx": "^2.1.1",
		"dayjs": "^1.11.20",
		"postcss": "^8.5.12",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"react-error-boundary": "^6.1.1",
		"react-router": "^7.15.0",
		"valibot": "^1.4.0",
		"valibot-i18n-better-ru": "^1.0.4"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^9.0.0",
		"@babel/core": "^7.29.0",
		"@eslint-react/eslint-plugin": "^5.7.7",
		"@rolldown/plugin-babel": "^0.2.3",
		"@svgr/plugin-jsx": "^8.1.0",
		"@svgr/plugin-svgo": "^8.1.0",
		"@types/node": "^25.7.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"deepmerge-ts": "^7.1.5",
		"eslint": "^10.3.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.4",
		"orval": "8.10.0",
		"prettier": "^3.8.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.12",
		"vite-bundle-analyzer": "^1.3.8",
		"vite-plugin-pwa": "^1.3.0",
		"vite-plugin-svgr": "^5.2.0"
	}
}
