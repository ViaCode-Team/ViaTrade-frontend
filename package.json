{
	"name": "viatrade-frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"prepare": "husky",
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"api:gen": "orval",
		"types": "tsc -p tsconfig.app.json",
		"lint": "set TIMING=1 && eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier . -c -u --cache",
		"format:fix": "prettier . -w -u --cache",
		"check": "npm run types && npm run lint && npm run format",
		"check:fix": "npm run types && npm run lint:fix && npm run format:fix"
	},
	"lint-staged": {
		"*.{ts,tsx}": "bash -c 'tsc -p tsconfig.app.json'",
		"*.{js,jsx,ts,tsx}": "eslint --fix",
		"*": "prettier -w -u --log-level error"
	},
	"dependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@mui/icons-material": "^7.3.8",
		"@mui/material": "^7.3.8",
		"@preact/preset-vite": "^2.10.4",
		"@tanstack/react-query": "^5.90.21",
		"@tanstack/react-query-devtools": "^5.91.3",
		"preact": "^10.29.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-router": "^7.13.1",
		"valibot": "^1.2.0",
		"valibot-i18n-better-ru": "^1.0.4"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^7.6.1",
		"@eslint-react/eslint-plugin": "^2.13.0",
		"@faker-js/faker": "^10.3.0",
		"@svgr/plugin-jsx": "^8.1.0",
		"@svgr/plugin-svgo": "^8.1.0",
		"@types/node": "^25.4.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.4",
		"babel-plugin-react-compiler": "^1.0.0",
		"deepmerge-ts": "^7.1.5",
		"eslint": "^9.39.2",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"globals": "^17.4.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.3.1",
		"msw": "^2.12.10",
		"orval": "^8.5.3",
		"prettier": "^3.8.1",
		"typescript": "~5.9.3",
		"vite": "^7.3.1",
		"vite-bundle-analyzer": "^1.3.6",
		"vite-plugin-pwa": "^1.2.0",
		"vite-plugin-svgr": "^4.5.0"
	}
}
