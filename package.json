{
	"name": "viatrade-frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"prepare": "husky",
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"api:gen": "orval && node scripts/generate-orval-types-index.mjs",
		"types": "tsc -p tsconfig.app.json",
		"lint": "set TIMING=1 && eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier . -c -u --cache",
		"format:fix": "prettier . -w -u --cache",
		"check": " npm run lint && npm run types && npm run format",
		"check:fix": "npm run lint:fix && npm run types && npm run format:fix"
	},
	"lint-staged": {
		"*.{ts,tsx}": "bash -c 'tsc -p tsconfig.app.json'",
		"*.{js,jsx,ts,tsx}": "eslint",
		"*": "prettier -u --log-level error"
	},
	"dependencies": {
		"@fontsource-variable/roboto": "^5.2.10",
		"@fontsource/poppins": "^5.2.7",
		"@mantine/charts": "^9.2.2",
		"@mantine/core": "^9.2.2",
		"@mantine/dates": "^9.2.2",
		"@mantine/form": "^9.2.2",
		"@mantine/hooks": "^9.2.2",
		"@mantine/modals": "^9.2.2",
		"@mantine/notifications": "^9.2.2",
		"@mantine/nprogress": "^9.2.2",
		"@tabler/icons-react": "^3.44.0",
		"@tanstack/query-async-storage-persister": "^5.100.14",
		"@tanstack/react-query": "^5.100.14",
		"@tanstack/react-query-devtools": "^5.100.14",
		"@tanstack/react-query-persist-client": "^5.100.14",
		"clsx": "^2.1.1",
		"dayjs": "^1.11.21",
		"idb-keyval": "^6.2.4",
		"js-cookie": "^3.0.8",
		"postcss": "^8.5.15",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"react-error-boundary": "^6.1.2",
		"react-router": "^7.16.0",
		"recharts": "^3.8.1",
		"valibot": "^1.4.0",
		"valibot-i18n-better-ru": "^1.0.4"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^9.0.0",
		"@babel/core": "^7.29.7",
		"@eslint-react/eslint-plugin": "^5.8.8",
		"@rolldown/plugin-babel": "^0.2.3",
		"@svgr/plugin-jsx": "^8.1.0",
		"@svgr/plugin-svgo": "^8.1.0",
		"@types/js-cookie": "^3.0.6",
		"@types/node": "^25.9.1",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.2",
		"babel-plugin-react-compiler": "^1.0.0",
		"deepmerge-ts": "^7.1.5",
		"eslint": "^10.4.1",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.4",
		"orval": "8.14.0",
		"prettier": "^3.8.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.14",
		"vite-bundle-analyzer": "^1.3.8",
		"vite-plugin-pwa": "^1.3.0",
		"vite-plugin-svgr": "^5.2.0"
	}
}
