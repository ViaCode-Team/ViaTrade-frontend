{
	"name": "viatrade-frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"prepare": "husky",
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"api:gen": "orval && node scripts/generate-orval-types-index.mjs",
		"types": "tsc -p tsconfig.app.json",
		"lint": "set TIMING=1 && eslint .",
		"lint:fix": "eslint . --fix",
		"arch": "steiger ./src",
		"arch:fix": "steiger ./src --fix",
		"format": "prettier . -c -u --cache",
		"format:fix": "prettier . -w -u --cache",
		"check": " npm run lint && npm run types && npm run arch && npm run format",
		"check:fix": "npm run lint:fix && npm run types && npm run arch:fix && npm run format:fix"
	},
	"lint-staged": {
		"*.{ts,tsx}": "bash -c 'tsc -p tsconfig.app.json'",
		"*.{js,jsx,ts,tsx}": "eslint",
		"*": "prettier -u --log-level error"
	},
	"dependencies": {
		"@fontsource-variable/roboto": "^5.3.0",
		"@fontsource/poppins": "^5.3.0",
		"@mantine/charts": "^9.5.1",
		"@mantine/core": "^9.5.1",
		"@mantine/dates": "^9.5.1",
		"@mantine/form": "^9.5.1",
		"@mantine/hooks": "^9.5.1",
		"@mantine/modals": "^9.5.1",
		"@mantine/notifications": "^9.5.1",
		"@mantine/nprogress": "^9.5.1",
		"@tabler/icons-react": "^3.46.0",
		"@tanstack/query-async-storage-persister": "^5.101.4",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-query-devtools": "^5.101.4",
		"@tanstack/react-query-persist-client": "^5.101.4",
		"clsx": "^2.1.1",
		"dayjs": "^1.11.21",
		"idb-keyval": "^6.3.0",
		"ky": "^2.0.2",
		"postcss": "^8.5.26",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-error-boundary": "^6.1.2",
		"react-lazily": "^0.9.2",
		"react-router": "^8.3.0",
		"recharts": "^3.10.1",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^9.3.0",
		"@babel/core": "^8.0.1",
		"@eslint-react/eslint-plugin": "^5.18.6",
		"@rolldown/plugin-babel": "^0.2.3",
		"@rolldown/plugin-transform-imports": "^0.1.1",
		"@types/node": "26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@vitejs/plugin-react": "^6.1.0",
		"babel-plugin-react-compiler": "^1.0.0",
		"deepmerge-ts": "^7.1.6",
		"eslint": "^10.9.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.4",
		"globals": "^17.11.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"orval": "8.26.0",
		"prettier": "^3.9.6",
		"steiger": "^0.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vite-bundle-analyzer": "^1.3.9",
		"vite-plugin-pwa": "^1.3.0"
	}
}
